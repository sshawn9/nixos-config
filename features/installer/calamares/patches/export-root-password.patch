Description: Export the root password alongside the user password
 The installer job persists both as NixOS password hashes instead of running
 Calamares' imperative password jobs after nixos-install.
diff --git a/src/modules/users/Config.cpp b/src/modules/users/Config.cpp
--- a/src/modules/users/Config.cpp
+++ b/src/modules/users/Config.cpp
@@ -1065,6 +1065,7 @@ Config::finalizeGlobalStorage() const
         gs->insert( "reuseRootPassword", reuseUserPasswordForRoot() );
     }
     gs->insert( "password", Calamares::String::obscure( userPassword() ) );
+    gs->insert( "rootPassword", Calamares::String::obscure( rootPassword() ) );
 }
 
 Calamares::JobList
