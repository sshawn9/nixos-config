Description: Remove network checks and GeoIP requests from offline media
diff --git a/config/modules/welcome.conf b/config/modules/welcome.conf
--- a/config/modules/welcome.conf
+++ b/config/modules/welcome.conf
@@ -5,16 +5,12 @@ requirements:
     requiredStorage: 10
     requiredRam: 3.0
 
-    internetCheckUrl: [ https://geoip.kde.org/v1/calamares, https://cache.nixos.org/ ]
-
     check:
         - storage
         - ram
         - power
-        - internet
         - screen
 
     required:
         - storage
         - ram
-        - internet
diff --git a/config/modules/locale.conf b/config/modules/locale.conf
--- a/config/modules/locale.conf
+++ b/config/modules/locale.conf
@@ -5,6 +5,3 @@ adjustLiveTimezone: false
 
 localeGenPath: @glibcLocales@/share/i18n/SUPPORTED
 
-geoip:
-    style: "json"
-    url: "https://geoip.kde.org/v1/calamares"
