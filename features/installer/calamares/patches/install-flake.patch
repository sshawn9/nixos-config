+        output = getattr(error, "output", None)
+        details = output.decode("utf8", errors="replace") if output else str(error)
+        return (_("Failed to prepare the installed configuration"), details)
+
     status = _("Installing NixOS")
     libcalamares.job.setprogress(INSTALL_PROGRESS_START)
 
