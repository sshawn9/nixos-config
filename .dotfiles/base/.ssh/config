Host kwrt
  hostname 10.0.0.1
  user root
  StrictHostKeyChecking no
  CheckHostIP no
  UserKnownHostsFile /dev/null
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host github.com
  hostname ssh.github.com
  port 443
  user git
  CheckHostIP no

Host 10.* 172.* 192.168.*.* 169.254.*.* 100.*
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  GlobalKnownHostsFile /dev/null
  CheckHostIP no
  LogLevel ERROR

Host *
  addKeysToAgent no
  compression no
  controlMaster no
  controlPath ~/.ssh/master-%r@%n:%p
  controlPersist no
  forwardAgent no
  hashKnownHosts no
  serverAliveCountMax 3
  serverAliveInterval 0
  StrictHostKeyChecking accept-new
  userKnownHostsFile ~/.ssh/known_hosts
