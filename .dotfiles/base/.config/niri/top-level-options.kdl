screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"
// prefer-no-csd

cursor {
    xcursor-theme "catppuccin-mocha-mauve-cursors"
    xcursor-size 28
}

recent-windows {
    highlight {
        corner-radius 12
    }
}

// Disable all compositor background blur, including client requests.
blur {
    off
}

// Global blur-off still permits xray; block background effects on all layers.
layer-rule {
    background-effect {
        blur false
        xray false
    }

    popups {
        background-effect {
            blur false
            xray false
        }
    }
}

hotkey-overlay { skip-at-startup; }

environment {
    "NIXOS_OZONE_WL" "1"
}
