// App sizes only; global.kdl leaves these apps to Niri's native layout detection.
window-rule {
    match app-id=r#"(?i)^code$"#
    match app-id=r#"(?i)^google-chrome(-beta|-unstable)?$"#
    match app-id=r#"(?i)^jetbrains-(clion|pycharm|rustrover)$"#
    match app-id=r#"(?i)^(microsoft-edge|com\.microsoft\.Edge)$"#
    match app-id=r#"(?i)^(antigravity-ide|Antigravity IDE)$"#
    match app-id=r#"(?i)^sqlitebrowser$"#
    match app-id=r#"(?i)^losslesscut$"#

    default-column-width { proportion 1.0; }
    default-window-height { proportion 1.0; }
}

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    match app-id=r#"(?i)^(github-desktop|GitHub Desktop)$"#
    match app-id=r#"(?i)^(obsidian|md\.obsidian\.Obsidian)$"#

    default-column-width { proportion 0.666667; }
}

window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#

    default-column-width { proportion 0.5; }
}
