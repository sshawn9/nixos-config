{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nix", "github-actions"],
  "includePaths": ["flake.nix", "flake.lock", ".github/workflows/**"],
  "labels": ["dependencies"],
  "timezone": "Asia/Shanghai",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Refresh Nix inputs through lock file maintenance; preserve input URLs and pinned tags.",
      "matchManagers": ["nix"],
      "matchDepNames": ["*"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "separateMajorMinor": false
    }
  ]
}
