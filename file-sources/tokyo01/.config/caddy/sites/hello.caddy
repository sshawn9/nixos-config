http://hello.sshawn9.com {
	redir https://hello.sshawn9.com{uri} permanent
}

# 创建公网 443 的 HTTPS 监听；该域名的 TCP 连接先由 L4 交给 Xray。
hello.sshawn9.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	root * {$REALITY_SITE_ROOT}
	file_server
}

# 按握手中的 SNI 复用上面管理的证书，不再为同一域名声明第二套证书策略。
https://:8443 {
	bind 127.0.0.1
	root * {$REALITY_SITE_ROOT}
	file_server
}
